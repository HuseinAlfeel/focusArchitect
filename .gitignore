# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Klartext-Zugangsdaten der Teilnehmenden, niemals versionieren
credentials.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# vom Tooling automatisch erzeugte KI-Agent-Dateien, nicht versionieren
AGENTS.md
skills-lock.json
.claude/
.windsurf/
.agents/

# Datenbank-Sicherungen. Sie enthalten alle Teilnehmerdaten UND die
# Passwort-Hashes der Accounts und duerfen nie ins Repo. Die Migrationen
# unter prisma/migrations und das Reset-Skript unter scripts/ bleiben
# ausdruecklich versioniert, deshalb wird hier nur der Projektstamm gesperrt.
/*.sql
/sicherung*.sql
/dump*.sql
