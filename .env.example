# Vorlage fuer die .env-Datei auf dem Server (fuer docker-compose.yml).
# Kopieren zu ".env" und mit ECHTEN, ANDEREN Werten als lokal fuellen -
# diese Datei hier enthaelt bewusst keine echten Passwoerter und darf im Git
# bleiben.

# Frei waehlbares, langes Passwort NUR fuer die Server-Datenbank.
DB_PASSWORD=

# Langer, zufaelliger String zum Signieren der Login-Cookies. Erzeugen z.B.
# mit: openssl rand -base64 32
SESSION_SECRET=
