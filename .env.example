# Vorlage fuer die Umgebungsvariablen. Enthaelt bewusst keine echten Werte
# und darf im Git bleiben. Je nach Deployment-Weg brauchst du nicht alles.

# ---------------------------------------------------------------------------
# Immer noetig
# ---------------------------------------------------------------------------

# Verbindung zur Datenbank.
#   lokal (docker-compose.dev.yml):
#     postgresql://focus:devpassword@localhost:5432/focusdb
#   bei Vercel: der GEPOOLTE Neon-String (Host enthaelt "-pooler"), weil jede
#     Serverless-Funktion sonst eine eigene Verbindung aufmacht und das Limit
#     sprengt. Fuer "prisma migrate deploy"/"db seed" von lokal aus dagegen
#     den DIREKTEN String nehmen, Migrationen moegen den Pooler nicht.
DATABASE_URL=

# Langer, zufaelliger String zum Signieren der Login-Cookies. Erzeugen z.B.
# mit: openssl rand -base64 32
# Auf dem Server/bei Vercel bewusst ein ANDERER Wert als lokal.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Nur fuer den Docker-/Hetzner-Weg (docker-compose.yml), bei Vercel unnoetig
# ---------------------------------------------------------------------------

# Frei waehlbares, langes Passwort NUR fuer die Server-Datenbank.
DB_PASSWORD=
